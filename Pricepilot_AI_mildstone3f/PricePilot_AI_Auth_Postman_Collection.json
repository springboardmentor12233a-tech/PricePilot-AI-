    },
    {
      "name": "4. Dynamic Price Optimization (LightGBM)",
      "description": "Trigger LightGBM regression price optimization on catalog SKUs.",
      "item": [
        {
          "name": "POST /api/price-optimization (Run LightGBM Optimization)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns recommended optimal price and confidence', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('recommended_price');",
                  "    pm.expect(json).to.have.property('confidence_score');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/price-optimization?product_id=2",
              "host": ["{{base_url}}"],
              "path": ["api", "price-optimization"],
              "query": [
                {
                  "key": "product_id",
                  "value": "2"
                }
              ]
            }
          }
        }
      ]
    },
