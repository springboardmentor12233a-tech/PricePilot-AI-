{
  "info": {
    "name": "PricePilot AI - JWT Authentication & Product Information APIs (Milestone 3)",
    "description": "Comprehensive Postman Collection for PricePilot AI Milestone 3.\n\nIncludes:\n1. JWT Authentication (Register, Login as Admin/Analyst/User, Get Profile, Token Validation)\n2. Product Information Operations (List, Filter, Search, Single Product Details, Add Product, Update Product, Delete Product, RBAC Forbidden Test, 401 Unauthorized Test)\n3. Catalog Information Operations (List Catalogs, Catalog Details with Elasticity)\n4. Price Optimization Engine (LightGBM Optimization API)\n5. OAuth 2.0 Social Authentication Flows (Google, GitHub, Microsoft)\n\nPre-configured tests automatically extract the JWT token on Login/Register and set the 'jwt_token', 'admin_jwt', 'analyst_jwt', and 'user_jwt' variables for chained protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_jwt",
      "value": "",
      "type": "string"
    },
    {
      "key": "analyst_jwt",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_jwt",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. JWT Authentication",
      "description": "Endpoints for User Registration, Login (issuing RFC 7519 HMAC-SHA256 JWT tokens), Profile retrieval, and Token validation.",
      "item": [
        {
          "name": "POST /api/auth/register (Create New Account & Issue JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains valid JWT access_token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json.token_type).to.eql('bearer');",
                  "    pm.collectionVariables.set('jwt_token', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yuvraj Patil\",\n  \"email\": \"yuvraj_test@pricepilot.ai\",\n  \"password\": \"SecurePass@123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "POST /api/auth/login (Admin Sign In - Issue Admin JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Admin JWT issued and saved', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json.user.role).to.eql('admin');",
                  "    pm.collectionVariables.set('jwt_token', json.access_token);",
                  "    pm.collectionVariables.set('admin_jwt', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pricepilot.ai\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "POST /api/auth/login (Analyst Sign In - Issue Analyst JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Analyst JWT issued and saved', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.user.role).to.eql('analyst');",
                  "    pm.collectionVariables.set('analyst_jwt', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@pricepilot.ai\",\n  \"password\": \"Analyst@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "POST /api/auth/login (User Sign In - Issue User JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('User JWT issued and saved', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.user.role).to.eql('user');",
                  "    pm.collectionVariables.set('user_jwt', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@pricepilot.ai\",\n  \"password\": \"User@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "GET /api/auth/me (Get Authenticated User Profile with JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Profile matches authenticated JWT user', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('email');",
                  "    pm.expect(json).to.have.property('role');",
                  "    pm.expect(json).to.have.property('permissions');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "GET /api/auth/me (Unauthorized Test - Missing JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Information Operations (JWT Protected)",
      "description": "Endpoints to fetch, filter, add, update, and delete product information. Demonstrates JWT security, complete 8+ parameter payloads, and Admin-only RBAC protection.",
      "item": [
        {
          "name": "GET /api/products (List All Products with Metrics)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns products list with financial metrics', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.products.length).to.be.at.least(15);",
                  "    pm.expect(json).to.have.property('total_revenue');",
                  "    pm.expect(json).to.have.property('average_margin_pct');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "GET /api/products?category=Electronics (Filter Products by Category)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned products belong to Electronics', function () {",
                  "    var json = pm.response.json();",
                  "    json.products.forEach(function(p) {",
                  "        pm.expect(p.category.toLowerCase()).to.eql('electronics');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/products?category=Electronics",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                {
                  "key": "category",
                  "value": "Electronics"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/products/1 (Get Single Product Detailed Information)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Product has all 8+ detailed parameters', function () {",
                  "    var p = pm.response.json();",
                  "    pm.expect(p).to.have.property('id');",
                  "    pm.expect(p).to.have.property('name');",
                  "    pm.expect(p).to.have.property('category');",
                  "    pm.expect(p).to.have.property('price');",
                  "    pm.expect(p).to.have.property('cost');",
                  "    pm.expect(p).to.have.property('competitor_avg');",
                  "    pm.expect(p).to.have.property('margin_pct');",
                  "    pm.expect(p).to.have.property('daily_demand');",
                  "    pm.expect(p).to.have.property('stock');",
                  "    pm.expect(p).to.have.property('sales_channel');",
                  "    pm.expect(p).to.have.property('rating');",
                  "    pm.expect(p).to.have.property('annual_revenue');",
                  "    pm.expect(p).to.have.property('status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/products/1",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "POST /api/products (Add New Product Information - Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('New product created with calculated metrics', function () {",
                  "    var p = pm.response.json();",
                  "    pm.expect(p.name).to.eql('SmartWatch Apex Ultra');",
                  "    pm.expect(p.margin_pct).to.be.above(0);",
                  "    pm.expect(p.competitor_avg).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SmartWatch Apex Ultra\",\n  \"category\": \"Electronics\",\n  \"price\": 299.99,\n  \"cost\": 145.00,\n  \"competitor_1\": 310.00,\n  \"competitor_2\": 305.00,\n  \"competitor_3\": 295.00,\n  \"daily_demand\": 25.0,\n  \"stock\": 600,\n  \"sales_channel\": \"Direct Web\",\n  \"rating\": 4.8,\n  \"status\": \"Optimal\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "POST /api/products (Forbidden Test - User Role Cannot Add Product)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Error message specifies Admin restriction', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.detail).to.include('Admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Product Addition\",\n  \"category\": \"Electronics\",\n  \"price\": 199.99,\n  \"cost\": 90.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "PUT /api/products/1 (Update Product Information - Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Product price and margin updated', function () {",
                  "    var p = pm.response.json();",
                  "    pm.expect(p.price).to.eql(249.99);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 249.99,\n  \"rating\": 4.9,\n  \"status\": \"Optimal\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products/1",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "GET /api/products (Unauthorized Test - Missing JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        }
      ]
    },
