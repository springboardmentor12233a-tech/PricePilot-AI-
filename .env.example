# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pricepilot

# --- Auth ---
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Providers (backend only -- never exposed to the frontend) ---
GROQ_API_KEY=YOUR_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-3.8-flash

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Admin bootstrap (used by scripts/create_admin.py) ---
ADMIN_EMAIL=admin@pricepilot.local
ADMIN_PASSWORD=ChangeMe123!
