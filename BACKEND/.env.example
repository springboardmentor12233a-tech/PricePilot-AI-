# Backend runtime settings (replace placeholders; never commit real credentials).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pricepilot
SECRET_KEY=replace-with-a-long-random-signing-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Email OTP is fail-closed. Configure SMTP before enabling login.
OTP_EMAIL_PROVIDER=disabled
OTP_EMAIL_FROM=pricepilot@example.com
OTP_SMTP_HOST=smtp.example.com
OTP_SMTP_PORT=587
OTP_SMTP_USERNAME=replace-with-smtp-username
OTP_SMTP_PASSWORD=replace-with-smtp-password
OTP_SMTP_USE_TLS=true
OTP_HASH_SECRET=replace-with-a-separate-random-secret
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOGIN_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900

# Set false only for local HTTP development. Production must use HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Trust forwarded headers only from explicitly listed proxy networks.
TRUSTED_PROXY_CIDRS=[]

# Optional operator-configured trusted IP geolocation endpoint.
# It must accept {ip} in the URL and return country, region, and city fields.
GEOLOCATION_API_URL=
GEOLOCATION_API_TOKEN=
# Retention: OTP rows are removed one day after expiry, security events after 90 days,
# and expired session/location records after 180 days, during login cleanup.
